#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/uv-cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$SCRIPT_DIR/data/xdg-data}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$SCRIPT_DIR/data/xdg-config}"
mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME"
exec uv run --extra dev --extra web xoctopus "$@"
